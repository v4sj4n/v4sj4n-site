# Public — baked in at build time (NEXT_PUBLIC_*)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
NEXT_PUBLIC_CONTACT_API_URL=/api/contact

# Local dev: Next.js proxies /api/contact to the Worker (npm run api:dev)
CONTACT_WORKER_DEV_URL=http://127.0.0.1:8787

# Cloudflare Worker / Pages Function secrets — .dev.vars locally, dashboard in production
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# NOTION_SECRET=your_notion_integration_secret
# NOTION_DB_ID=your_notion_database_id
# CONTACT_EMAIL=hello@v4sj4n.com
# ALLOWED_ORIGIN=https://v4sj4n.com
