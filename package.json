{
	"name": "v4sj4n-site",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"api:dev": "wrangler dev --config wrangler.contact.jsonc --port 8787",
		"api:deploy": "wrangler deploy --config wrangler.contact.jsonc",
		"pages:dev": "npm run build && wrangler pages dev out --port 8788",
		"pages:deploy": "npm run build && wrangler pages deploy out",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"extract-metadata": "node scripts/extract-metadata.mjs"
	},
	"dependencies": {
		"lucide-react": "^1.21.0",
		"motion": "^12.40.0",
		"next": "16.2.9",
		"next-intl": "^4.13.0",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250620.0",
		"@biomejs/biome": "2.5.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4",
		"typescript": "^5",
		"wrangler": "^4.20.0"
	}
}
